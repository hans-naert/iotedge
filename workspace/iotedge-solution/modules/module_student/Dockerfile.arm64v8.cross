# syntax=docker/dockerfile:1.4
ARG SDK_IMAGE=iotedge-sdk-arm64:latest

# Build stage
FROM ${SDK_IMAGE} AS build
WORKDIR /app
COPY . .

RUN rm -rf CMakeCache.txt CMakeFiles/ build/ && \
    cmake -B build -S . \
      -DCMAKE_TOOLCHAIN_FILE=/opt/vcpkg/scripts/buildsystems/vcpkg.cmake \
      -DVCPKG_CHAINLOAD_TOOLCHAIN_FILE=/opt/toolchain-arm64.cmake \
      -DVCPKG_TARGET_TRIPLET=arm64-linux \
      -DCMAKE_BUILD_TYPE=Release && \
    cmake --build build -j$(nproc) && \
    aarch64-linux-gnu-strip build/main

# Helper stage to collect only required libraries
FROM ${SDK_IMAGE} AS deps
COPY --from=build /app/build/main /tmp/main

RUN mkdir -p /runtime/lib /runtime/lib/aarch64-linux-gnu /runtime/etc /runtime/usr/share && \
    # Kopieer dynamic linker en glibc libs van toolchain
    cp /usr/aarch64-linux-gnu/lib/ld-linux-aarch64.so.1 /runtime/lib/ && \
    cp /usr/aarch64-linux-gnu/lib/*.so* /runtime/lib/aarch64-linux-gnu/ 2>/dev/null || true && \
    # Kopieer vcpkg gecompileerde shared libraries (Azure SDK, OpenSSL, libcurl, etc.)
    cp /opt/vcpkg/installed/arm64-linux/lib/*.so* /runtime/lib/aarch64-linux-gnu/ 2>/dev/null || true && \
    # Certificaten en netwerkconfiguratie voor DNS
    if [ -d "/etc/ssl" ]; then cp -r /etc/ssl /runtime/etc/; fi && \
    if [ -d "/usr/share/ca-certificates" ]; then cp -r /usr/share/ca-certificates /runtime/usr/share/; fi && \
    echo "nameserver 127.0.0.11" > /runtime/etc/resolv.conf && \
    echo "127.0.0.1 localhost" > /runtime/etc/hosts && \
    echo "hosts: files dns" > /runtime/etc/nsswitch.conf

# Runtime stage
FROM scratch
COPY --from=deps /runtime/lib/ld-linux-aarch64.so.1 /lib/
COPY --from=deps /runtime/lib/aarch64-linux-gnu/ /lib/aarch64-linux-gnu/
COPY --from=deps /runtime/etc/ /etc/
COPY --from=deps /runtime/usr/share/ /usr/share/
COPY --from=build /app/build/main /app/main

CMD ["/app/main"]