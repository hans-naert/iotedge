FROM debian:12
ENV DEBIAN_FRONTEND=noninteractive

# 1. Installeer zowel native build tools (voor de x64 host tools) als de aarch64 cross-compilers
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    cmake \
    ninja-build \
    make \
    curl \
    ca-certificates \
    git \
    pkg-config \
    zip \
    unzip \
    tar \
    bison \
    flex \
    && rm -rf /var/lib/apt/lists/*

# 2. Vcpkg ophalen en bootstrap uitvoeren
ENV VCPKG_ROOT=/opt/vcpkg
ENV VCPKG_FORCE_SYSTEM_BINARIES=1
RUN git clone --depth 1 https://github.com/microsoft/vcpkg.git ${VCPKG_ROOT} && \
    ${VCPKG_ROOT}/bootstrap-vcpkg.sh -disableMetrics

# 3. Definieer het CMake toolchain bestand voor ARM64 cross-compilatie
RUN printf "set(CMAKE_SYSTEM_NAME Linux)\n\
set(CMAKE_SYSTEM_PROCESSOR aarch64)\n\
set(CMAKE_C_COMPILER aarch64-linux-gnu-gcc)\n\
set(CMAKE_CXX_COMPILER aarch64-linux-gnu-g++)\n" > /opt/toolchain-arm64.cmake

# 4. Koppel de cross-toolchain aan het arm64-linux community triplet van vcpkg
RUN mkdir -p ${VCPKG_ROOT}/triplets/community && \
    printf "set(VCPKG_TARGET_ARCHITECTURE arm64)\n\
set(VCPKG_CRT_LINKAGE dynamic)\n\
set(VCPKG_LIBRARY_LINKAGE dynamic)\n\
set(VCPKG_CMAKE_SYSTEM_NAME Linux)\n\
set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE /opt/toolchain-arm64.cmake)\n" > ${VCPKG_ROOT}/triplets/community/arm64-linux.cmake

# 5. Installeer de Azure IoT C SDK voor ARM64
RUN ${VCPKG_ROOT}/vcpkg install azure-iot-sdk-c:arm64-linux --clean-after-build && \
    rm -rf ${VCPKG_ROOT}/downloads ${VCPKG_ROOT}/packages

WORKDIR /app